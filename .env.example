# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8788/auth/google/callback

# Session signing
SESSION_SECRET=replace-with-a-long-random-string

# Sanity Content Lake
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Pay2S Collection Link
# Use https://sandbox-payment.pay2s.vn/v1/gateway/api/create while testing.
PARTNER_CODE=
ACCESS_KEY=
SECRET_KEY=
API_TAO_GIAO_DICH=https://payment.pay2s.vn/v1/gateway/api/create
# One account per line, in the format: account_number|bank_code
STK_BANK_ACCOUNTS=

# Optional: set this to protect the Partner Webhook endpoint.
PAY2S_WEBHOOK_TOKEN=
